{
  "name": "Flexa",
  "version": "1.0.0",
  "description": "Compact CSS package for Developing Web UI. Responsive ready and easy to use.",
  "license": "MIT",
  "type": "module",
  "main": "dist/js/flexa.js",
  "style": "dist/css/core.css",
  "unpkg": "dist/css/core.min.css",
  "jsdelivr": "dist/css/core.min.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:build": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && npm run build:css && npm run build:themes && npm run build:js && npm run build:cdn && npm run build:themes:cdn && npm run build:js:cdn",
    "build:css": "node -e \"require('fs').mkdirSync('dist/css', { recursive: true })\" && sass --no-error-css --style=expanded --source-map --embed-sources src/core.scss dist/css/core.css",
    "build:themes": "node -e \"require('fs').mkdirSync('dist/css/themes', { recursive: true })\" && sass --no-error-css --style=expanded --source-map --embed-sources src/themes/theme-default.scss dist/css/themes/theme-default.css",
    "build:js": "node -e \"require('fs').mkdirSync('dist/js', { recursive: true })\" && node -e \"require('fs').copyFileSync('src/js/flexa.js', 'dist/js/flexa.js')\"",
    "build:cdn": "postcss dist/css/core.css --map --output dist/css/core.min.css",
    "build:themes:cdn": "postcss dist/css/themes/theme-default.css --map --output dist/css/themes/theme-default.min.css",
    "build:js:cdn": "npx terser dist/js/flexa.js --compress --mangle --output dist/js/flexa.min.js --source-map \"url='flexa.min.js.map'\"",
    "stylelint:scss": "stylelint \"src/**/*.scss\"",
    "stylelint:css": "stylelint \"dist/css/**/*.css\"",
    "stylelint:scss:fix": "stylelint \"src/**/*.scss\" --fix"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.45",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.4",
    "terser": "^5.36.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
