{
  "name": "microuikit",
  "version": "1.0.0",
  "description": "Compact front-end framework for micro UIs. Fully responsive, WCAG 2.1 compliant, with built-in RTL/LTR support, flexible theming, and an easy to use.",
  "license": "MIT",
  "author": "Mahdi Atashin | DokuDesk",
  "type": "module",
  "main": "./dist/js/microuikit.js",
  "style": "./dist/css/microuikit.css",
  "unpkg": "./dist/css/microuikit.min.css",
  "jsdelivr": "./dist/css/microuikit.min.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.js"
  ],
  "exports": {
    ".": {
      "import": "./dist/js/microuikit.js",
      "default": "./dist/js/microuikit.js"
    },
    "./css": "./dist/css/microuikit.css",
    "./css/min": "./dist/css/microuikit.min.css",
    "./theme/default": "./dist/css/themes/microuikit-theme-default.css",
    "./theme/default/min": "./dist/css/themes/microuikit-theme-default.min.css"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:css": "node -e \"require('fs').mkdirSync('dist/css', { recursive: true })\" && sass --no-error-css --style=expanded --source-map --embed-sources src/microuikit.scss dist/css/microuikit.css",
    "build:themes": "node -e \"require('fs').mkdirSync('dist/css/themes', { recursive: true })\" && sass --no-error-css --style=expanded --source-map --embed-sources src/themes/microuikit-theme-default.scss dist/css/themes/microuikit-theme-default.css",
    "build:js": "node -e \"require('fs').mkdirSync('dist/js', { recursive: true })\" && node -e \"require('fs').copyFileSync('src/js/microuikit.js', 'dist/js/microuikit.js')\"",
    "build:cdn": "postcss dist/css/microuikit.css --map --output dist/css/microuikit.min.css",
    "build:themes:cdn": "postcss dist/css/themes/microuikit-theme-default.css --map --output dist/css/themes/microuikit-theme-default.min.css",
    "build:js:cdn": "npx terser dist/js/microuikit.js --compress --mangle --output dist/js/microuikit.min.js --source-map \"url='microuikit.min.js.map'\"",
    "build": "npm run clean && npm-run-all build:css build:themes build:js build:cdn build:themes:cdn build:js:cdn",
    "lint": "stylelint \"src/**/*.scss\"",
    "lint:fix": "stylelint \"src/**/*.scss\" --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest": "npm run build",
    "pretest:run": "npm run build",
    "pretest:coverage": "npm run build"
  },
  "keywords": [
    "css",
    "scss",
    "design-tokens",
    "utility-classes",
    "responsive",
    "rtl",
    "ltr",
    "theme",
    "dark-mode",
    "light-mode",
    "auto-mode",
    "ui",
    "frontend",
    "microsystems",
    "micro-ui",
    "microuikit",
    "micro-ui-css",
    "micro-components",
    "micro-framework",
    "frontend-framework",
    "lightweight-css",
    "modular-css",
    "atomic-css",
    "micro-layout",
    "responsive-ui",
    "accessible-css",
    "wcag-compliant",
    "ui-library"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DokuDesk/microuikit.git"
  },
  "bugs": {
    "url": "https://github.com/DokuDesk/microuikit/issues"
  },
  "homepage": "https://github.com/DokuDesk/microuikit#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^5.0.1",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "jsdom": "^25.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.45",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.4",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "terser": "^5.36.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}